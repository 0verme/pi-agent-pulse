{
	"name": "pi-agent-pulse",
	"version": "0.1.0",
	"description": "Task monitoring, watchdogs and pluggable notifications for Pi Agent.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0verme/pi-agent-pulse.git"
	},
	"homepage": "https://github.com/0verme/pi-agent-pulse#readme",
	"bugs": {
		"url": "https://github.com/0verme/pi-agent-pulse/issues"
	},
	"keywords": [
		"pi-package",
		"pi-agent",
		"pi-extension",
		"agent-monitoring",
		"watchdog",
		"feishu",
		"webhook",
		"ai-agent"
	],
	"license": "MIT",
	"author": "0verme",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "npm@11.12.1",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extension": {
			"types": "./dist/extension/pi.d.ts",
			"import": "./dist/extension/pi.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"prepack": "npm run build",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:package": "npm run build && node scripts/package-smoke.mjs",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.84.4 <0.86.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@eslint/js": "9.39.1",
		"@types/node": "22.19.19",
		"eslint": "9.39.1",
		"prettier": "3.6.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.46.4",
		"vitest": "4.1.11"
	},
	"pi": {
		"extensions": [
			"./dist/extension/pi.js"
		]
	}
}
